# Copia este archivo como .env y completa los valores en tu servidor.
# No subas .env a internet ni lo compartas.

PORT=3000

# Envío real del formulario de contacto mediante Resend.
# Verifica mygexpress.pe en Resend antes de usar CONTACT_FROM.
RESEND_API_KEY=
CONTACT_FROM=MyG Express <web@myg-express.com>
CONTACT_EMAIL=mygexpress30@gmail.com

# Protección anti-bots de Cloudflare Turnstile (obligatoria en producción).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Límite del endpoint público de tracking por instancia.
# Para despliegues con múltiples instancias usa además el rate limiting del proveedor/edge.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Opcion preferida si Urbano tiene un endpoint publico/sin token.
# Puedes usar {code} dentro de la URL o configurar el parametro de guia.
URBANO_PUBLIC_TRACKING_URL=https://api.urbanoenvios.pe/api/v1/trackingGlobal
URBANO_PUBLIC_METHOD=POST
URBANO_PUBLIC_BODY_TYPE=json
URBANO_PUBLIC_CODE_PARAM=guia_barra

# Parametros extra si el endpoint los pide, por ejemplo:
# URBANO_PUBLIC_EXTRA=page=1&start=0&limit=25
URBANO_PUBLIC_EXTRA=flag_seller=0

# Opcion recomendada: login automatico desde backend.
# La URL exacta y los nombres de campos salen del request de login en DevTools > Network.
URBANO_LOGIN_URL=
URBANO_LOGIN_METHOD=POST
URBANO_USERNAME=
URBANO_PASSWORD=
URBANO_USERNAME_FIELD=username
URBANO_PASSWORD_FIELD=password

# Campos extra del login si Urbano los pide, por ejemplo:
# URBANO_LOGIN_EXTRA=token=abc123&empresa=MYG
URBANO_LOGIN_EXTRA=

# Tiempo para reutilizar la sesion antes de verificar/renovar.
URBANO_SESSION_TTL_MS=1200000
URBANO_TIMEOUT_MS=10000

# Opcion temporal de desarrollo si aun no tienes automatizado el login:
# URBANO_PHPSESSID=
# URBANO_COOKIE=
